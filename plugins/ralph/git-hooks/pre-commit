#!/usr/bin/env bash
# Two staged-path guards, in order:
#
#   1. Filename length — delegated to filename-length-guard.sh.
#   2. Unicode normalization — implemented below.
#
# Reject commits whose staged paths duplicate an existing tree path under a
# different Unicode normalization (NFC vs NFD). macOS APFS auto-collapses both
# forms into one working-tree file, but `git ls-tree` records the byte form
# that reached the index — so a tree can end up with two entries that render
# identically on macOS yet check out as duplicates on Linux/Windows.
#
# Reproducer: a downstream project accumulated 4 NFD-duplicate paths after
# an autonomous commit synthesized filenames in NFD while NFC originals were
# already on master. See TASK-136 for the incident.

set -euo pipefail

# Filename-length guard (TASK-227): reject staged paths whose name components
# exceed the 125-byte cap the ecryptfs sync target imposes. The logic lives in
# a tracked, testable script rather than inline here. Run from the plugin
# (plugins/ralph/git-hooks/), this hook uses the guard bundled beside it in
# plugins/ralph/hooks/; run as a legacy copy in .git/hooks, it falls back to the
# project's .claude/hooks copy (TASK-297). Projects bootstrapped before the
# guard existed lack both and skip, matching the graceful bail-out the NFC
# check below uses when no normalizer is available.
#
# This runs FIRST: the NFC check exits 0 early on an empty stage or a missing
# HEAD, which would otherwise skip the length guard on a repo's first commit.
repo_root=$(git rev-parse --show-toplevel)
length_guard="$(dirname "$0")/../hooks/filename-length-guard.sh"
[ -x "$length_guard" ] || length_guard="$repo_root/.claude/hooks/filename-length-guard.sh"
if [ -x "$length_guard" ]; then
  "$length_guard" || exit 1
fi

# core.quotePath=false → emit raw UTF-8 bytes instead of C-style \320\271 escapes.
# Without this, NFC and NFD forms render as different escape strings, so the
# normalization check below sees two distinct paths whose bytes appear "equal"
# under any encoding round-trip.
staged=$(git -c core.quotePath=false diff --cached --name-only)
[ -z "$staged" ] && exit 0

# No HEAD yet (empty repo, first commit) → nothing to compare against.
head_paths=$(git -c core.quotePath=false ls-tree -r HEAD --name-only 2>/dev/null) || exit 0
[ -z "$head_paths" ] && exit 0

# Pick a normalizer once. macOS BSD iconv ships utf-8-mac (NFD → NFC).
# Linux glibc iconv does not; fall back to a Python interpreter.
#
# Candidates are probed by RUNNING them, not by `command -v` (TASK-242): a
# devcontainer can carry a python3 first in PATH that cannot start at all —
# e.g. an interpreter copied from an official python:* image whose glibc is
# newer than the base image's. `command -v` finds it, every to_nfc call then
# exits non-zero, and `set -euo pipefail` aborts the hook — so every commit in
# the container is rejected. Probing by execution falls through to the next
# candidate instead.
if printf '' | iconv -f utf-8-mac -t utf-8 >/dev/null 2>&1; then
  to_nfc() { printf '%s' "$1" | iconv -f utf-8-mac -t utf-8; }
else
  nfc_python=""
  for cand in python3 /usr/bin/python3 python /usr/bin/python; do
    command -v "$cand" >/dev/null 2>&1 || continue
    "$cand" -c 'import unicodedata' >/dev/null 2>&1 || continue
    nfc_python="$cand"
    break
  done
  if [ -z "$nfc_python" ]; then
    echo "pre-commit: no NFC normalizer available (iconv -f utf-8-mac unsupported, no runnable python). Skipping NFC check." >&2
    exit 0
  fi
  to_nfc() { "$nfc_python" -c 'import sys, unicodedata; sys.stdout.write(unicodedata.normalize("NFC", sys.argv[1]))' "$1"; }
fi

# bash 3.2 (macOS /bin/bash) has no associative arrays (TASK-294): index HEAD
# as "nfc<TAB>path" lines and look a key up with awk. The key travels through
# ENVIRON, not `awk -v`, because -v expands backslash escapes and git prints a
# path containing a backslash as a quoted, escaped string. The `""` concatenation
# forces a string comparison — awk would otherwise compare "1.0" == "1" as numbers.
head_index=""
while IFS= read -r p; do
  [ -z "$p" ] && continue
  head_index+="$(to_nfc "$p")"$'\t'"$p"$'\n'
done <<< "$head_paths"

violations=()
while IFS= read -r p; do
  [ -z "$p" ] && continue
  nfc=$(to_nfc "$p")
  existing=$(printf '%s' "$head_index" | NFC_KEY="$nfc" awk -F'\t' '$1 "" == ENVIRON["NFC_KEY"] "" { print $2 }')
  [ -z "$existing" ] && continue
  while IFS= read -r e; do
    [ -z "$e" ] && continue
    if [ "$e" != "$p" ]; then
      violations+=("staged: $p  vs  tree: $e")
    fi
  done <<< "$existing"
done <<< "$staged"

if [ ${#violations[@]} -gt 0 ]; then
  echo "BLOCKED: staged path duplicates existing tree path under a different Unicode normalization (NFD vs NFC)." >&2
  printf '  %s\n' "${violations[@]}" >&2
  echo "Resolve: 'git mv <staged> <tree>' to keep the existing tree-form, or 'git rm --cached <tree>' if the new form is correct." >&2
  exit 1
fi

exit 0
